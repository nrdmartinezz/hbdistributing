---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';

const categories = [
  { id: 'all', label: 'All News' },
  { id: 'company', label: 'Company Updates' },
  { id: 'industry', label: 'Industry Insights' },
  { id: 'logistics', label: 'Logistics Trends' },
];

const articles = [
  {
    category: 'company',
    label: 'Company Updates',
    date: 'Oct 24, 2024',
    title: 'HB Distributing Opens New Automated Hub in Frankfurt',
    excerpt:
      'Our newest facility expands our European footprint, featuring next-generation robotics that increase sorting efficiency by 40% and shorten cross-dock dwell time.',
    image: '/images/insight-frankfurt.png',
    featured: true,
  },
  {
    category: 'industry',
    label: 'Industry Insights',
    date: 'Oct 18, 2024',
    title: 'Navigating Q4 Capacity Constraints',
    excerpt:
      'Expert analysis on securing carrier space ahead of the holiday peak season, with the lanes most likely to tighten first.',
    image: '/images/insight-capacity.png',
    featured: false,
  },
  {
    category: 'logistics',
    label: 'Logistics Trends',
    date: 'Oct 12, 2024',
    title: 'The Rise of Predictive Analytics in Freight',
    excerpt:
      'How machine learning algorithms are moving from reactive tracking to proactive delay prevention across ocean and domestic moves.',
    image: '/images/insight-analytics.png',
    featured: false,
  },
  {
    category: 'company',
    label: 'Company Updates',
    date: 'Oct 05, 2024',
    title: 'Fleet Modernization Initiative Complete',
    excerpt:
      "We've successfully upgraded 100% of our domestic fleet to lower-emission vehicles, cutting idle time and fuel spend on core lanes.",
    image: '/images/insight-fleet.png',
    featured: false,
  },
  {
    category: 'industry',
    label: 'Industry Insights',
    date: 'Sep 28, 2024',
    title: 'Understanding New Customs Regulations',
    excerpt:
      'A breakdown of the recent changes to cross-border documentation requirements and how importers can stay ahead of holds.',
    image: '/images/insight-customs.png',
    featured: false,
  },
];

const counts = Object.fromEntries(
  categories.map((category) => [
    category.id,
    category.id === 'all'
      ? articles.length
      : articles.filter((article) => article.category === category.id).length,
  ]),
);
---

<BaseLayout
  title="Latest Insights"
  description="Stay informed with the latest updates from HB Distributing, industry trends, and deep dives into global logistics optimization."
>
  <section class="py-16" data-insights>
    <Container>
      <h1 class="text-ink-base text-4xl font-bold md:text-5xl">Latest Insights</h1>
      <p class="text-ink-muted mt-3 max-w-2xl text-lg leading-7">
        Stay informed with the latest updates from HB Distributing, industry trends, and deep dives
        into global logistics optimization.
      </p>

      <div class="mt-10 grid items-start gap-8 lg:grid-cols-12">
        <aside class="bg-brand-100 rounded-lg p-6 lg:col-span-3">
          <label class="text-ink-base text-sm font-semibold" for="news-search">Search News</label>
          <div class="relative mt-3">
            <img
              src="/images/icons/search.svg"
              alt=""
              width="18"
              height="18"
              class="pointer-events-none absolute top-1/2 left-3 -translate-y-1/2"
            />
            <input
              id="news-search"
              type="search"
              placeholder="Keywords..."
              class="border-line-base w-full rounded-sm border bg-white py-3 pr-3 pl-10"
              data-search
            />
          </div>
          <p class="text-ink-muted mt-6 text-xs font-semibold tracking-[0.08em] uppercase">
            Categories
          </p>
          <ul class="mt-3 flex flex-col gap-1">
            {
              categories.map((category, index) => (
                <li>
                  <button
                    type="button"
                    class:list={[
                      'flex min-h-11 w-full items-center justify-between rounded-sm px-3 py-2 text-left text-sm',
                      index === 0
                        ? 'bg-brand-200 text-brand-900 font-semibold'
                        : 'text-ink-muted hover:bg-white',
                    ]}
                    data-filter={category.id}
                    aria-pressed={index === 0 ? 'true' : 'false'}
                  >
                    {category.label}
                    <span>{counts[category.id]}</span>
                  </button>
                </li>
              ))
            }
          </ul>
        </aside>

        <div class="flex flex-col gap-6 lg:col-span-9">
          {
            articles
              .filter((article) => article.featured)
              .map((article) => (
                <article
                  id={article.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}
                  data-article
                  data-category={article.category}
                  data-text={`${article.title} ${article.excerpt}`.toLowerCase()}
                  class="grid overflow-hidden rounded-lg bg-white shadow-sm lg:grid-cols-2"
                >
                  <img
                    src={article.image}
                    alt=""
                    width="512"
                    height="279"
                    class="h-full min-h-52 w-full object-cover"
                  />
                  <div class="flex flex-col p-6">
                    <div class="text-ink-muted flex items-center justify-between gap-3 text-xs">
                      <span
                        class:list={[
                          'rounded-full px-2 py-1 font-semibold tracking-wide uppercase',
                          article.category === 'company' && 'text-accent-600 bg-[#ffe8d6]',
                          article.category === 'industry' && 'bg-[#d9f5e3] text-[#0b6b3a]',
                          article.category === 'logistics' && 'bg-brand-200 text-brand-900',
                        ]}
                      >
                        {article.label}
                      </span>
                      <time>{article.date}</time>
                    </div>
                    <h2 class="text-ink-base mt-4 text-2xl leading-8 font-semibold">
                      {article.title}
                    </h2>
                    <p class="text-ink-muted mt-2 flex-1 leading-6">{article.excerpt}</p>
                    <a
                      href={`#${article.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                      class="text-brand-900 mt-4 inline-flex min-h-11 items-center gap-2 text-sm font-semibold no-underline"
                    >
                      {article.featured ? 'Read Full Story' : 'Read More'}
                      {article.featured && (
                        <img src="/images/icons/arrow-navy.svg" alt="" width="9" height="9" />
                      )}
                    </a>
                  </div>
                </article>
              ))
          }

          <div class="grid gap-6 md:grid-cols-2" data-grid>
            {
              articles
                .filter((article) => !article.featured)
                .map((article) => (
                  <article
                    data-article
                    data-category={article.category}
                    data-text={`${article.title} ${article.excerpt}`.toLowerCase()}
                    class="flex flex-col overflow-hidden rounded-lg bg-white shadow-sm"
                  >
                    <img
                      src={article.image}
                      alt=""
                      width="512"
                      height="279"
                      class="h-48 w-full object-cover"
                    />
                    <div class="flex flex-1 flex-col p-6">
                      <div class="text-ink-muted flex items-center justify-between gap-3 text-xs">
                        <span
                          class:list={[
                            'rounded-full px-2 py-1 font-semibold tracking-wide uppercase',
                            article.category === 'company' && 'text-accent-600 bg-[#ffe8d6]',
                            article.category === 'industry' && 'bg-[#d9f5e3] text-[#0b6b3a]',
                            article.category === 'logistics' && 'bg-brand-200 text-brand-900',
                          ]}
                        >
                          {article.label}
                        </span>
                        <time>{article.date}</time>
                      </div>
                      <h2 class="text-ink-base mt-3 text-xl font-semibold">{article.title}</h2>
                      <p class="text-ink-muted mt-2 flex-1 text-sm leading-6">{article.excerpt}</p>
                      <a
                        href={`#${article.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                        class="text-brand-900 mt-4 inline-flex min-h-11 items-center text-sm font-semibold no-underline"
                      >
                        Read More
                      </a>
                    </div>
                  </article>
                ))
            }
          </div>

          <p class="text-ink-muted hidden text-sm" data-empty>No stories match that search.</p>

          <nav class="mt-4 flex items-center justify-center gap-2" aria-label="Insights pages">
            <span class="text-ink-muted px-3 py-2" aria-hidden="true">‹</span>
            <span
              class="bg-brand-900 flex size-11 items-center justify-center rounded-full text-sm font-semibold text-white"
              aria-current="page">1</span
            >
            <span class="text-ink-muted flex size-11 items-center justify-center text-sm">2</span>
            <span class="text-ink-muted flex size-11 items-center justify-center text-sm">3</span>
            <span class="text-ink-muted px-2">…</span>
            <span class="text-ink-muted px-3 py-2" aria-hidden="true">›</span>
          </nav>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-insights]');
  if (root) {
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const filters = [...root.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const cards = [...root.querySelectorAll<HTMLElement>('[data-article]')];
    const empty = root.querySelector<HTMLElement>('[data-empty]');
    let category = 'all';

    const apply = () => {
      const query = (search?.value ?? '').trim().toLowerCase();
      let visible = 0;
      for (const card of cards) {
        const matchesCategory = category === 'all' || card.dataset.category === category;
        const matchesQuery = !query || (card.dataset.text ?? '').includes(query);
        const show = matchesCategory && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      }
      if (empty) empty.hidden = visible > 0;
    };

    search?.addEventListener('input', apply);
    for (const button of filters) {
      button.addEventListener('click', () => {
        category = button.dataset.filter ?? 'all';
        for (const item of filters) {
          const active = item === button;
          item.setAttribute('aria-pressed', String(active));
          item.classList.toggle('bg-brand-200', active);
          item.classList.toggle('text-brand-900', active);
          item.classList.toggle('font-semibold', active);
        }
        apply();
      });
    }
  }
</script>
