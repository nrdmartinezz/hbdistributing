---
/**
 * WEBPRO LogDash — first-party analytics. Emits a deferred script tag when
 * `site.analytics.logdash` is set; separate from third-party tags in Analytics.
 */
import { logdashWebsiteId } from '../../config/site';

const websiteId = logdashWebsiteId;
---

{
  websiteId && (
    <script
      is:inline
      defer
      src="https://logdash-east.webpro.com/script.js"
      data-website-id={websiteId}
    />
  )
}
