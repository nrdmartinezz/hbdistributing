---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import { navigation } from '../../config/navigation';
import { site } from '../../config/site';
---

<Section as="footer" background="muted" spacing="none" class="border-line-base border-t pt-20 pb-6">
  <Container gap="none" class="gap-20">
    <div class="grid w-full gap-8 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-4">
        <a href="/">
          <img
            src="/images/logo-header.png"
            alt="Highland Breeze Distributing"
            width="150"
            height="128"
            class="h-32 w-auto"
          />
        </a>
        <p class="text-ink-muted max-w-xs text-base leading-6">
          Industrial product distribution, sourcing, and supply chain support for manufacturers,
          OEMs, maintenance teams, and industrial customers.
        </p>
      </div>

      {
        navigation.footer.map((group) => (
          <nav aria-label={group.heading} class="flex flex-col gap-4">
            <h2 class="text-brand-900 text-sm font-semibold tracking-[0.04em] uppercase">
              {group.heading}
            </h2>
            <ul class="flex flex-col gap-2">
              {group.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-ink-muted hover:text-brand-900 inline-flex min-h-11 items-center text-base leading-6 no-underline"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="flex flex-col gap-4">
        <h2 class="text-brand-900 text-sm font-semibold tracking-[0.04em] uppercase">Contact</h2>
        <ul class="text-ink-muted flex flex-col gap-2 text-base leading-6">
          <li>{site.business.address.street}</li>
          {site.business.address.line2 && <li>{site.business.address.line2}</li>}
          <li>
            {site.business.address.locality}, {site.business.address.region}{' '}
            {site.business.address.postalCode}
          </li>
          <li>
            <a
              href={`mailto:${site.business.email}`}
              class="hover:text-brand-900 inline-flex min-h-11 items-center no-underline"
            >
              {site.business.email}
            </a>
          </li>
          <li>
            <a
              href={`tel:${site.business.phoneHref}`}
              class="text-accent-600 inline-flex min-h-11 items-center font-bold no-underline"
            >
              {site.business.phone}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-line-base/30 flex w-full flex-col gap-3 border-t pt-6 text-xs font-medium md:flex-row md:items-center md:justify-between"
    >
      <p class="text-ink-muted">
        © {new Date().getFullYear()}
        {site.legalName} All rights reserved.
      </p>
      <ul class="flex flex-wrap gap-6">
        {
          navigation.legal.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-ink-muted hover:text-brand-900 inline-flex min-h-11 items-center no-underline"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</Section>
