---
import type { HTMLAttributes } from 'astro/types';

export type ButtonVariant = 'primary' | 'secondary' | 'ghost' | 'inverse';
export type ButtonSize = 'sm' | 'md' | 'lg';

type Props = {
  variant?: ButtonVariant;
  size?: ButtonSize;
  href?: string;
  class?: string;
} & Omit<HTMLAttributes<'a'>, 'class'> &
  Omit<HTMLAttributes<'button'>, 'class'>;

const { variant = 'primary', size = 'md', href, class: className, ...rest } = Astro.props;

const Tag = href ? 'a' : 'button';

const variants: Record<ButtonVariant, string> = {
  primary: 'bg-accent-600 text-neutral-0 hover:bg-accent-500 border-transparent',
  secondary: 'bg-transparent text-brand-900 border-2 border-brand-900 hover:bg-brand-100',
  ghost: 'bg-transparent text-ink-base border-transparent hover:bg-neutral-100',
  inverse: 'bg-neutral-0 text-brand-900 border-transparent hover:bg-brand-50',
};

// min-h keeps every size above the 44px touch target on small screens.
const sizes: Record<ButtonSize, string> = {
  sm: 'min-h-11 px-4 text-sm',
  md: 'min-h-12 px-6 text-base',
  lg: 'min-h-14 px-8 text-lg',
};
---

<Tag
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-sm border font-semibold tracking-[0.04em]',
    'no-underline transition-colors duration-150',
    'disabled:pointer-events-none disabled:opacity-50',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
